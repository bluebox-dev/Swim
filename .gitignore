# ── secrets: never commit ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.credentials

# ── build output and local data ──
.build/
*.exe
*.msi
*.wim
*.iso
*.qcow2
*.img
node_modules/

# ── editor / OS ──
.DS_Store
.idea/
.vscode/
.claude/
*.swp

# ── site-specific nginx files (public name, trusted proxies) ──
builder-infra/nginx/public-host.conf
builder-infra/nginx/*.local.inc

# ── plugins: which ones are linked in is a choice of each installation ──
plugins/enabled
backend/cmd/server/plugins_gen.go
agent/cmd/swim-agent/plugins_gen.go
