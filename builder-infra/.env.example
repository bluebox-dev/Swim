# Example only. The real file is builder-infra/.env — scripts/setup-host.sh creates it with
# fresh random values (mode 0600). It is in .gitignore: never commit it.
#
# To create it by hand instead:  cp .env.example .env  and replace every <…> with
#   openssl rand -hex 24      (passwords and admin tokens; tokens need ≥ 24 characters)
#   openssl rand -hex 16      (GUAC_JSON_SECRET: exactly 32 hex characters)

SWIM_DATA=/srv/swim

# PostgreSQL: owner runs migrations, app is what the backend uses (cannot alter the audit log)
PG_OWNER_PASSWORD=<openssl rand -hex 24>
PG_APP_PASSWORD=<openssl rand -hex 24>

# Break-glass admin tokens, name:token pairs. Used to sign in until the first admin
# account (password + authenticator app) exists; keep them secret afterwards.
SWIM_ADMIN_TOKENS=admin1:<openssl rand -hex 24>,admin2:<openssl rand -hex 24>

# Shared secret between the backend and Guacamole (console / Remote Desktop links)
GUAC_JSON_SECRET=<openssl rand -hex 16>

# Optional settings (defaults shown) — add them under "environment:" of the backend
# service in docker-compose.yml if you need to change them:
#   SWIM_PUBLIC_URL=https://<server>     printed in setup links by `swim-server user add`
#   SWIM_AUDIT_KEEP_DAYS=90              activity log retention (minimum 30)
#   SWIM_EXAM_KEEP_DAYS=30               exam plugin: evidence (screenshots) is deleted after this many days
#   SWIM_TWO_PERSON=false                true = a second admin must approve images
#   SWIM_HEARTBEAT_S=60                  agent heartbeat interval
